# LOCUS Environment Configuration Template
# Copy this file to .env and configure local environment variables if needed.

# Serial Collector Configuration
LOCUS_SERIAL_PORT=COM3
LOCUS_BAUD_RATE=115200
LOCUS_SERIAL_TIMEOUT_SEC=1.5

# Pipeline Paths
LOCUS_DATA_RAW_DIR=data/raw
LOCUS_DATA_STRUCTURED_DIR=data/structured
LOCUS_DATA_FEATURES_DIR=data/features
LOCUS_DATA_EVIDENCE_DIR=data/evidence
LOCUS_MODELS_DIR=models

# SOC REST API Configuration
LOCUS_API_HOST=127.0.0.1
LOCUS_API_PORT=8000
# Production / Render Backend API URL for Streamlit GUI:
LOCUS_API_URL=https://locus-5b9g.onrender.com

# SOC GUI Dashboard Configuration
LOCUS_GUI_HOST=localhost
LOCUS_GUI_PORT=8501


