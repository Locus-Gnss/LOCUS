# LOCUS Frontend Environment Configuration Example
# Copy this file to .env.local to configure local variables.
# Never commit .env or .env.local with real credentials to source control.

# FastAPI Backend URL (Leave blank to use Vite development proxy on /api)
VITE_API_URL=

# CARTO Basemaps API Key (Optional)
# CARTO Dark Matter raster tiles load freely for standard Leaflet usage.
# If using a commercial/custom CARTO account, generate a free key at: https://carto.com/basemaps/apikey/
VITE_CARTO_API_KEY=your_carto_api_key_placeholder
